# ==============================================================================
# Axiom Backend Environment Variables
# ==============================================================================
# Copy this file to .env in the same directory (apps/api/backend/.env):
#   cp .env.example .env
# ==============================================================================

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=axiom

# Server Port
PORT=5000

# Security & Cryptography Configuration
# ENCRYPTION_KEY: Must be a 32-byte key formatted as Base64 or 64-char Hex string.
# Used for AES-256-GCM encryption of sensitive student data and API keys.
# Generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=jZalr1MqFbyvLYKP65v2FW9Lduj7wJbUbHBfTTx7HdQ=

# LOOKUP_HMAC_KEY: Secret string used for SHA-256 HMAC lookup indices
# Generate one or use any strong passphrase:
LOOKUP_HMAC_KEY=axiom_secure_hmac_secret_salt_key

# Canvas LMS Integration (Optional)
# If using a live Canvas instance, set your institution base URL and access token.
# CANVAS_API_KEY=your_canvas_bearer_token_here
# CANVAS_BASE_URL=https://instructure.charlotte.edu
